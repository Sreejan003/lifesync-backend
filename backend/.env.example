# ============================================================
# LifeSync Backend — Environment Variables
# Copy this file to .env and fill in values for your environment
# ============================================================

# ----------------------------
# Server
# ----------------------------
PORT=5000
NODE_ENV=development
# Production: NODE_ENV=production

# ----------------------------
# Database
# ----------------------------
# Local dev: leave empty → auto-uses SQLite (lifesync.db)
# Railway:   paste your PostgreSQL public proxy URL
# Neon/Supabase: paste your connection string
DATABASE_URL=
# Example: postgresql://postgres:PASSWORD@monorail.proxy.rlwy.net:PORT/railway

# ----------------------------
# Security (use strong secrets in production!)
# ----------------------------
JWT_SECRET=your_production_jwt_session_secret_min_32_chars
JWT_RESET_SECRET=your_isolated_password_reset_jwt_secret_min_32_chars

# ----------------------------
# CORS — Allowed Frontend Origins
# ----------------------------
# Local dev:
CLIENT_URL=http://localhost:5000
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Production (Railway backend + Vercel frontend):
# CLIENT_URL=https://your-app.vercel.app
# ALLOWED_ORIGINS=https://your-app.vercel.app

# Production (Everything on Railway):
# CLIENT_URL=https://your-backend.up.railway.app
# ALLOWED_ORIGINS=https://your-backend.up.railway.app

# ----------------------------
# Frontend API URL
# ----------------------------
# Set this in js/config.js on the frontend side (not here)
# window.__LIFESYNC_API_URL__ = 'https://your-backend.up.railway.app/api'

# ----------------------------
# Google OAuth 2.0
# ----------------------------
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_PROJECT_ID=your_google_project_id

# ----------------------------
# Mailjet — Transactional Email (password reset)
# ----------------------------
MAILJET_API_KEY=your_mailjet_api_key
MAILJET_SECRET_KEY=your_mailjet_secret_key
MAILJET_SENDER_EMAIL=noreply@yourdomain.com
MAILJET_SENDER_NAME=LifeSync
